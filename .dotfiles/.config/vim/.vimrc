" Custom Indentation
set tabstop=4
set shiftwidth=4
set expandtab

" Line Numbers
set number
set relativenumber

" Search Tweaks
set ignorecase
set smartcase

" Language-specific Indent
set smartindent

" Syntax & File Matching
syntax on
filetype plugin indent on

" True 24-bit Color Support
set termguicolors

" Permanent Theme Selection
colorscheme habamax