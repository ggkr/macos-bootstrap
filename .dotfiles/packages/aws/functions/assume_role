function assume_role () {
  COLOR_YELLOW='\033[0;33m'
  COLOR_RED='\033[1;31m'
  COLOR_OFF='\033[0m'
  SESSION_DURATION=3600
  ACCOUNT=$(aws sts get-caller-identity --query "Account" --output text) 2> /dev/null
  if [[ "$ACCOUNT" == "" ]] then;
    echo "${COLOR_RED}Error: Login with okta first${COLOR_OFF}"
    return 1
  fi
  if [[ $1 =~ 'arn:aws:iam::([0-9]+):role/(.*)' ]]; then
    ACCOUNT=$match[1]
    ROLE_NAME=$(echo $match[2] | tr '/' '_')
    ROLE_TO_ASSUME=$1
    if [[ $2 =~ '([0-9]+)' ]]; then
      SESSION_DURATION=$match[1]
    fi
  else
    if [[ $# == 1 ]] then;
      ROLE_NAME=$1
    elif [[ $# == 2 ]] then;
      if [[ $1 =~ '([0-9]+)' ]] then;
        ACCOUNT=$1
        ROLE_NAME=$2
      else
        ROLE_NAME=$1
        SESSION_DURATION=$2
      fi
    else
      ACCOUNT=$1
      ROLE_NAME=$2
      SESSION_DURATION=$3
    fi
    ROLE_TO_ASSUME="arn:aws:iam::${ACCOUNT}:role/${ROLE_NAME}"
  fi
  # echo ACCOUNT=$ACCOUNT
  # echo ROLE_NAME=$ROLE_NAME
  # echo SESSION_DURATION=$SESSION_DURATION
  session_name="${ACCOUNT}_${ROLE_NAME}"
  awscli_output=$(aws sts assume-role --role-arn $ROLE_TO_ASSUME --role-session-name "${session_name:0:64}" --duration-seconds "${SESSION_DURATION}" --output json) || echo "sts command failed"
  export AWS_ACCESS_KEY_ID=$(echo "${awscli_output}" | jq -r .Credentials.AccessKeyId)
  export AWS_SECRET_ACCESS_KEY=$(echo "${awscli_output}" | jq -r .Credentials.SecretAccessKey)
  export AWS_SESSION_TOKEN=$(echo "${awscli_output}" | jq -r .Credentials.SessionToken)
  echo "${COLOR_YELLOW}$(aws sts get-caller-identity)${COLOR_OFF}"
  return 0
}